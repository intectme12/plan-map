DATABASE_URL="postgresql://planmap:planmap@localhost:55432/planmap"

# 로그인(better-auth) — 세션 서명용 랜덤 문자열, 플레이스홀더 그대로 두면 안 됨
BETTER_AUTH_SECRET="change-me-to-a-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

NEXT_PUBLIC_KAKAO_JS_KEY=""
KAKAO_REST_API_KEY=""

# OAuth 로그인 — 각 콘솔에서 발급, 리디렉션 URI는 {BETTER_AUTH_URL}/api/auth/callback/<provider>
# 구글: https://console.cloud.google.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# 카카오: https://developers.kakao.com (이메일 동의항목은 사업자 인증 필요 — 미인증 시 코드가 대체 이메일로 처리함)
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""
# 네이버: https://developers.naver.com
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""

# AI 일정 자동생성(F4) — https://console.groq.com 에서 발급
GROQ_API_KEY=""

# 클라이언트 IP를 읽을 프록시 헤더: cloudflare | nginx (미설정이면 IP 기준 요청 제한 꺼짐) — docs/SECURITY_PLAN.md
# TRUST_PROXY="cloudflare"

# 외부 API 비용 보호 — 실제 콘솔 쿼터/요금제에 맞게 설정(미설정 시 기본값). docs/SECURITY_PLAN.md
# KAKAO_LOCAL_DAILY_QUOTA=100000
# KAKAO_DIRECTIONS_DAILY_QUOTA=10000
# AI_DAILY_TOKEN_BUDGET=1000000
# AI_USER_DAILY_TOKEN_LIMIT=100000
# AI_MAX_CONCURRENCY=4
# UPLOAD_USER_DAILY_BYTES=314572800
# SSE_MAX_CONNECTIONS=2000
