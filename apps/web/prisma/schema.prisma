generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  nickname           String   @unique
  role               String   @default("USER") // "USER" | "ADMIN"
  bio                String?
  avatarUrl          String?
  showTripsOnProfile Boolean  @default(true)
  createdAt          DateTime @default(now())

  trips            Trip[]
  notices          Notice[]
  tripShares       TripShare[]
  tripParticipants TripParticipant[]
  reviews          Review[]

  @@map("users")
}

model Notice {
  id        String   @id @default(cuid())
  authorId  String
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@map("notices")
}

model Trip {
  id         String    @id @default(cuid())
  userId     String
  name       String
  startDate  DateTime
  endDate    DateTime
  personnel  Int       @default(1)
  visibility String    @default("PRIVATE") // "PRIVATE" | "UNLISTED" | "PUBLIC"
  sharedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  places       PlaceEntry[]
  shares       TripShare[]
  participants TripParticipant[]

  @@index([userId])
  @@index([visibility, sharedAt])
  @@map("trips")
}

// 오너가 특정 회원에게 명시적으로 공유함 — visibility와 무관하게 항상 열람을 허용하고,
// 여행 내용(장소/지출/사진/후기/별점) 전체 수정도 허용한다. 공개범위 변경과 공유 대상 관리만 오너 전용.
model TripShare {
  id        String   @id @default(cuid())
  tripId    String
  userId    String
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([userId])
  @@map("trip_shares")
}

// 여행 생성 시 등록하는 동행자 — 가입 회원(userId 있음)은 등록과 동시에 TripShare로 열람 권한도 갖고,
// 미가입자는 userId 없이 이름만 기록한다 (계정이 없어 공유 권한을 줄 수 없음).
model TripParticipant {
  id        String   @id @default(cuid())
  tripId    String
  userId    String?
  name      String
  createdAt DateTime @default(now())

  trip Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([userId])
  @@map("trip_participants")
}

model PlaceEntry {
  id          String    @id @default(cuid())
  tripId      String
  order       Int
  name        String
  category    String?
  lat         Float
  lng         Float
  address     String?
  roadAddress String?
  placeUrl    String?
  phone       String?
  scheduledAt DateTime?
  rating      Int       @default(0) // 0~5, 후기 탭 별점
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  trip     Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  expenses Expense[]
  photos   Photo[]
  reviews  Review[]

  routesFrom RouteSegment[] @relation("RouteFrom")
  routesTo   RouteSegment[] @relation("RouteTo")

  @@index([tripId, order])
  @@map("place_entries")
}

model RouteSegment {
  id          String   @id @default(cuid())
  fromPlaceId String
  toPlaceId   String
  distanceM   Int
  durationSec Int
  fareWon     Int? // 카카오모빌리티 예상 택시요금
  path        Json? // 실제 도로 경로 좌표 [{lat,lng}, ...] — 카카오모빌리티 응답의 vertexes에서 추출
  computedAt  DateTime @default(now())

  fromPlace PlaceEntry @relation("RouteFrom", fields: [fromPlaceId], references: [id], onDelete: Cascade)
  toPlace   PlaceEntry @relation("RouteTo", fields: [toPlaceId], references: [id], onDelete: Cascade)

  @@unique([fromPlaceId, toPlaceId])
  @@map("route_segments")
}

model Expense {
  id           String   @id @default(cuid())
  placeEntryId String
  amount       Int
  category     String   @default("기타") // "음식" | "교통" | "입장권" | "숙소" | "기타"
  memo         String?
  source       String   @default("manual") // "manual" | "card_auto"
  createdAt    DateTime @default(now())

  placeEntry PlaceEntry @relation(fields: [placeEntryId], references: [id], onDelete: Cascade)

  @@index([placeEntryId])
  @@map("expenses")
}

model Photo {
  id           String    @id @default(cuid())
  placeEntryId String
  storageKey   String
  takenAt      DateTime?
  createdAt    DateTime  @default(now())

  placeEntry PlaceEntry @relation(fields: [placeEntryId], references: [id], onDelete: Cascade)

  @@index([placeEntryId])
  @@map("photos")
}

model Review {
  id           String   @id @default(cuid())
  placeEntryId String
  authorId     String
  content      String
  createdAt    DateTime @default(now())

  placeEntry PlaceEntry @relation(fields: [placeEntryId], references: [id], onDelete: Cascade)
  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([placeEntryId])
  @@index([authorId])
  @@map("reviews")
}
