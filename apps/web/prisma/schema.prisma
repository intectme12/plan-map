generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// email/비밀번호 + OAuth(카카오/구글/네이버) 로그인은 better-auth가 관장한다 — docs/OAUTH.md 참고.
// passwordHash는 better-auth 도입 이전 계정의 잔여 컬럼(레거시 안전망)이고, 이후 로그인은
// account 테이블(providerId="credential")의 password를 쓴다. emailVerified/updatedAt은
// better-auth가 요구하는 필드, nickname은 better-auth user.fields에서 name으로 매핑된다.
model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  emailVerified      Boolean  @default(false)
  passwordHash       String? // 레거시(마이그레이션 이전 계정), 더 이상 로그인에 쓰이지 않음
  nickname           String   @unique
  role               String   @default("USER") // "USER" | "ADMIN"
  bio                String?
  avatarUrl          String?
  showTripsOnProfile Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  trips              Trip[]
  notices            Notice[]
  tripShares         TripShare[]
  tripParticipants   TripParticipant[]
  reviews            Review[]
  sessions           Session[]
  accounts           Account[]
  conversationsAsA   Conversation[]    @relation("ConversationAsA")
  conversationsAsB   Conversation[]    @relation("ConversationAsB")
  sentMessages       Message[]
  following          Follow[]          @relation("Following")
  followers          Follow[]          @relation("Followers")
  tripLikes          TripLike[]
  notificationsReceived Notification[] @relation("NotificationsReceived")
  notificationsSent     Notification[] @relation("NotificationsSent")

  @@map("users")
}

// followerId가 followingId를 팔로우한다. 자기 자신 팔로우 금지·중복 팔로우 방지는
// 서비스 레이어(lib/services/follows.ts)에서 검증하고, @@unique는 마지막 안전망.
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

// 1:1 DM. 그룹채팅은 지원 안 해서 참여자 조인 테이블 대신 userA/userB 두 컬럼을 직접 둔다 —
// 서비스 레이어(lib/services/conversations.ts)가 두 id를 항상 정렬해서 저장해 같은 두 사람
// 사이 대화가 중복 생성되지 않게 한다(@@unique로 강제).
model Conversation {
  id                String    @id @default(cuid())
  userAId           String
  userBId           String
  userALastReadAt   DateTime?
  userBLastReadAt   DateTime?
  lastMessageAt     DateTime  @default(now())
  lastMessagePreview String?  // 목록 화면에서 매번 마지막 메시지를 따로 조회하지 않도록 미리 계산해 저장(사진만 보내면 "사진")
  lastMessageSenderId String? // 안읽음 판정에 씀(메시지가 아직 하나도 없으면 null이라 "안읽음" 아님)
  createdAt         DateTime  @default(now())

  userA    User      @relation("ConversationAsA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User      @relation("ConversationAsB", fields: [userBId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([userAId, userBId])
  @@index([userBId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String?
  imageKey       String? // lib/upload.ts의 storageKey 형식 — /uploads/messages/<conversationId>/<uuid>.ext
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// 아래 세 모델은 better-auth가 요구하는 스키마(session/account/verification)를
// 이 프로젝트의 명명 규칙(camelCase 컬럼, snake_case 테이블)에 맞춰 그대로 둔 것 —
// better-auth 옵션에서 별도 modelName 매핑 없이도 Prisma Client 접근자(prisma.session 등)와
// 기본 내부 키가 일치해서 필드명만 기본값 그대로 쓴다.
model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// providerId="credential"인 row가 이메일/비밀번호 계정의 비밀번호 해시(password)를 갖는다.
model Account {
  id                    String    @id @default(cuid())
  userId                String
  providerId            String
  accountId             String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model Notice {
  id        String   @id @default(cuid())
  authorId  String
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@map("notices")
}

model Trip {
  id         String    @id @default(cuid())
  userId     String
  name       String
  startDate  DateTime
  endDate    DateTime
  personnel  Int       @default(1)
  visibility String    @default("PRIVATE") // "PRIVATE" | "UNLISTED" | "PUBLIC"
  sharedAt   DateTime?
  coverPhotoKey String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  places       PlaceEntry[]
  shares       TripShare[]
  participants TripParticipant[]
  likes        TripLike[]
  notifications Notification[]

  @@index([userId])
  @@index([visibility, sharedAt])
  @@map("trips")
}

// 열람 가능한(공개/링크공개/오너 본인/공유받은) 여행에 대한 좋아요. 열람 권한 자체는
// 서비스 레이어(lib/services/tripLikes.ts)가 getSharedTrip과 동일한 기준으로 검증한다.
model TripLike {
  id        String   @id @default(cuid())
  tripId    String
  userId    String
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([tripId])
  @@map("trip_likes")
}

// type을 문자열로 두는 이유는 Trip.visibility와 같은 패턴 — 값 종류가 적어서 native enum
// 도입 이득이 아직 없음. tripId는 "LIKE"일 때만 쓰고("어떤 여행에 좋아요를 눌렀는지"),
// "FOLLOW"일 때는 null.
model Notification {
  id        String    @id @default(cuid())
  userId    String // 알림을 받는 사람
  actorId   String // 알림을 발생시킨 사람
  type      String    @default("FOLLOW") // "FOLLOW" | "LIKE"
  tripId    String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user  User  @relation("NotificationsReceived", fields: [userId], references: [id], onDelete: Cascade)
  actor User  @relation("NotificationsSent", fields: [actorId], references: [id], onDelete: Cascade)
  trip  Trip? @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

// 오너가 특정 회원에게 명시적으로 공유함 — visibility와 무관하게 항상 열람을 허용하고,
// 여행 내용(장소/지출/사진/후기/별점) 전체 수정도 허용한다. 공개범위 변경과 공유 대상 관리만 오너 전용.
model TripShare {
  id        String   @id @default(cuid())
  tripId    String
  userId    String
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([userId])
  @@map("trip_shares")
}

// 여행 생성 시 등록하는 동행자 — 가입 회원(userId 있음)은 등록과 동시에 TripShare로 열람 권한도 갖고,
// 미가입자는 userId 없이 이름만 기록한다 (계정이 없어 공유 권한을 줄 수 없음).
model TripParticipant {
  id        String   @id @default(cuid())
  tripId    String
  userId    String?
  name      String
  createdAt DateTime @default(now())

  trip Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([userId])
  @@map("trip_participants")
}

model PlaceEntry {
  id          String    @id @default(cuid())
  tripId      String
  order       Int
  name        String
  category    String?
  lat         Float
  lng         Float
  address     String?
  roadAddress String?
  placeUrl    String?
  phone       String?
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  trip     Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  expenses Expense[]
  photos   Photo[]

  routesFrom RouteSegment[] @relation("RouteFrom")
  routesTo   RouteSegment[] @relation("RouteTo")

  @@index([tripId, order])
  @@map("place_entries")
}

model RouteSegment {
  id          String   @id @default(cuid())
  fromPlaceId String
  toPlaceId   String
  distanceM   Int
  durationSec Int
  fareWon     Int? // 카카오모빌리티 예상 택시요금
  path        Json? // 실제 도로 경로 좌표 [{lat,lng}, ...] — 카카오모빌리티 응답의 vertexes에서 추출
  computedAt  DateTime @default(now())

  fromPlace PlaceEntry @relation("RouteFrom", fields: [fromPlaceId], references: [id], onDelete: Cascade)
  toPlace   PlaceEntry @relation("RouteTo", fields: [toPlaceId], references: [id], onDelete: Cascade)

  @@unique([fromPlaceId, toPlaceId])
  @@map("route_segments")
}

model Expense {
  id           String   @id @default(cuid())
  placeEntryId String
  amount       Int
  category     String   @default("기타") // "음식" | "교통" | "입장권" | "숙소" | "기타"
  memo         String?
  source       String   @default("manual") // "manual" | "card_auto"
  createdAt    DateTime @default(now())

  placeEntry PlaceEntry @relation(fields: [placeEntryId], references: [id], onDelete: Cascade)

  @@index([placeEntryId])
  @@map("expenses")
}

model Photo {
  id           String    @id @default(cuid())
  placeEntryId String
  storageKey   String
  takenAt      DateTime?
  createdAt    DateTime  @default(now())

  placeEntry PlaceEntry @relation(fields: [placeEntryId], references: [id], onDelete: Cascade)

  @@index([placeEntryId])
  @@map("photos")
}

// 카카오/네이버 장소 리뷰처럼 "실제 장소" 단위로 전체공개되는 후기 — PlaceEntry(트립 안의 장소 사본)에
// 종속되지 않고 좌표(lat/lng)로 실제 장소를 식별한다(같은 장소면 카카오 검색 결과가 항상 같은 좌표를 주므로
// 별도의 Place 테이블/카카오 ID 수집 없이도 충분히 매칭됨). 트립/PlaceEntry를 지워도 후기는 안 사라진다.
model Review {
  id        String   @id @default(cuid())
  lat       Float
  lng       Float
  authorId  String
  rating    Int // 1~5
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([authorId, lat, lng]) // 사람당 같은 장소엔 후기 1개 — 재작성은 upsert로 수정 처리
  @@index([lat, lng])
  @@map("reviews")
}
