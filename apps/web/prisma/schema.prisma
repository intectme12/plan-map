generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nickname     String
  createdAt    DateTime @default(now())

  trips Trip[]

  @@map("users")
}

model Trip {
  id        String   @id @default(cuid())
  userId    String
  name      String
  startDate DateTime
  endDate   DateTime
  personnel Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  places PlaceEntry[]

  @@index([userId])
  @@map("trips")
}

model PlaceEntry {
  id               String    @id @default(cuid())
  tripId           String
  order            Int
  name             String
  category         String?
  lat              Float
  lng              Float
  address          String?
  roadAddress      String?
  placeUrl         String?
  scheduledAt      DateTime?
  transportToNext  String    @default("car") // "car" | "bus"
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  trip     Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  expenses Expense[]
  photos   Photo[]

  routesFrom RouteSegment[] @relation("RouteFrom")
  routesTo   RouteSegment[] @relation("RouteTo")

  @@index([tripId, order])
  @@map("place_entries")
}

model RouteSegment {
  id          String   @id @default(cuid())
  fromPlaceId String
  toPlaceId   String
  mode        String // "car" | "bus"
  distanceM   Int
  durationSec Int
  fareWon     Int?
  detail      Json? // 대중교통 구간별 상세(지하철/버스 노선, 정류장) — mode="bus"일 때만 채워짐
  computedAt  DateTime @default(now())

  fromPlace PlaceEntry @relation("RouteFrom", fields: [fromPlaceId], references: [id], onDelete: Cascade)
  toPlace   PlaceEntry @relation("RouteTo", fields: [toPlaceId], references: [id], onDelete: Cascade)

  @@unique([fromPlaceId, toPlaceId, mode])
  @@map("route_segments")
}

model Expense {
  id           String   @id @default(cuid())
  placeEntryId String
  amount       Int
  memo         String?
  source       String   @default("manual") // "manual" | "card_auto"
  createdAt    DateTime @default(now())

  placeEntry PlaceEntry @relation(fields: [placeEntryId], references: [id], onDelete: Cascade)

  @@index([placeEntryId])
  @@map("expenses")
}

model Photo {
  id           String   @id @default(cuid())
  placeEntryId String
  storageKey   String
  takenAt      DateTime?
  createdAt    DateTime @default(now())

  placeEntry PlaceEntry @relation(fields: [placeEntryId], references: [id], onDelete: Cascade)

  @@index([placeEntryId])
  @@map("photos")
}
